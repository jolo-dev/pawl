{
	"extends": "@tsconfig/node24/tsconfig.json",
	"compilerOptions": {
		"target": "ES2024",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"types": ["bun-types", "node"]
	},
	"include": [
		"index.ts",
		"local.dev.ts",
		"src/**/*.ts",
		"stacks/**/*.ts",
		"tests/**/*.ts"
	]
}
