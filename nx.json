{
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"defaultBase": "main",
	"targetDefaults": {
		"test": {
			"cache": true,
			"parallelism": true
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["{workspaceRoot}/dist/{projectRoot}"],
			"cache": true,
			"parallelism": true
		}
	},
	"plugins": [
		{
			"plugin": "@nx/js/typescript",
			"options": {
				"typecheck": {
					"targetName": "typecheck"
				},
				"build": {
					"targetName": "build",
					"configName": "tsconfig.build.json"
				}
			}
		}
	]
}
