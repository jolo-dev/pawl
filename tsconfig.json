{
	"extends": "@tsconfig/node22/tsconfig.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowJs": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"paths": {
			"@pawl/agentcore": ["./packages/agentcore/index.ts"],
			"@pawl/cdk": ["./packages/cdk/index.ts"],
			"@pawl/lambda": ["./packages/lambda/index.ts"]
		}
	},
	"exclude": ["**/cdk.out/**", "**/dist/**", "node_modules/**"]
}
